<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ModificarPerfil.ModificarController"
            style="-fx-background-color: #f0f4f8;">

    <!-- Cabecera -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #2c3e50; -fx-padding: 12 16;">
            <Label text="Modificar perfil" styleClass="sidebar-title"
                   style="-fx-font-size: 16px;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="14" style="-fx-padding: 24;">

            <VBox spacing="8" maxWidth="420" styleClass="card">

                <!-- Nickname (no editable) -->
                <Label text="Nickname (no modificable)" styleClass="section-title" />
                <TextField fx:id="txtNick" editable="false"
                           style="-fx-background-color: #ecf0f1;" />

                <!-- Email -->
                <Label text="Correo electrónico *" styleClass="section-title" />
                <TextField fx:id="txtEmail" promptText="usuario@dominio.com" />
                <Label fx:id="lblEmailError" styleClass="error-label"
                       visible="false" managed="false" wrapText="true" />

                <!-- Contraseña -->
                <Label text="Nueva contraseña (dejar en blanco para no cambiar)"
                       styleClass="section-title" />
                <PasswordField fx:id="txtPassword"
                               promptText="Dejar en blanco = mantener la actual" />
                <Label fx:id="lblPassError" styleClass="error-label"
                       visible="false" managed="false" wrapText="true" />

                <!-- Fecha de nacimiento -->
                <Label text="Fecha de nacimiento *" styleClass="section-title" />
                <DatePicker fx:id="dpBirthDate" maxWidth="Infinity" />
                <Label fx:id="lblFechaError" styleClass="error-label"
                       visible="false" managed="false" wrapText="true" />

                <!-- Avatar -->
                <Label text="Avatar" styleClass="section-title" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fx:id="ivAvatar" fitWidth="60" fitHeight="60"
                               preserveRatio="true"
                               style="-fx-border-color: #bdc3c7; -fx-border-radius: 4;" />
                    <Button text="Cambiar imagen..." onAction="#seleccionarAvatar"
                            styleClass="btn-secondary" />
                    <Button text="Quitar avatar" onAction="#quitarAvatar"
                            styleClass="btn-danger" />
                </HBox>

                <!-- Mensaje de resultado -->
                <Label fx:id="lblMensaje" wrapText="true"
                       visible="false" managed="false">
                    <VBox.margin><Insets top="4"/></VBox.margin>
                </Label>

                <!-- Botones -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <VBox.margin><Insets top="8"/></VBox.margin>
                    <Button text="Cancelar" onAction="#cancelar" styleClass="btn-secondary" />
                    <Button text="Guardar cambios" onAction="#guardar" styleClass="btn-primary" />
                </HBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
