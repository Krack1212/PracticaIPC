<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<!--CSS HECHO CON IA-->


<ScrollPane fitToWidth="true"
            style="-fx-background-color: #f0f4f8;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mapademo.RegistroController">

    <VBox alignment="CENTER" spacing="15"
          style="-fx-background-color: #f0f4f8; -fx-padding: 40;">
        <children>

            
            <ImageView fitHeight="60" fitWidth="60" preserveRatio="true">
                <image><Image url="@../resources/logo.png" /></image>
            </ImageView>

            <Label text="Crear cuenta" styleClass="title-label" />
            <Label text="* Campos obligatorios" styleClass="subtitle-label" />

            
            <VBox spacing="6" maxWidth="400" styleClass="card">

                
                <Label text="Nickname *" styleClass="section-title" />
                <TextField fx:id="txtNick"
                           promptText="6-15 caracteres: letras, dígitos, -, _" />
                <Label fx:id="lblNickError" styleClass="error-label"
                       visible="false" managed="false" wrapText="true" />

                
                <Label text="Correo electrónico *" styleClass="section-title" />
                <TextField fx:id="txtEmail" promptText="usuario@dominio.com" />
                <Label fx:id="lblEmailError" styleClass="error-label"
                       visible="false" managed="false" wrapText="true" />

                
                <Label text="Contraseña *" styleClass="section-title" />
                <PasswordField fx:id="txtPassword"
                               promptText="8-20 chars, mayúscula, minúscula, dígito, símbolo" />
                <Label fx:id="lblPassError" styleClass="error-label"
                       visible="false" managed="false" wrapText="true" />

                
                <Label text="Fecha de nacimiento *" styleClass="section-title" />
                <DatePicker fx:id="dpBirthDate" maxWidth="Infinity"
                            promptText="dd/MM/yyyy" />
                <Label fx:id="lblFechaError" styleClass="error-label"
                       visible="false" managed="false" wrapText="true" />

                
                <Label text="Avatar (opcional)" styleClass="section-title" />
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <ImageView fx:id="ivAvatar" fitWidth="52" fitHeight="52"
                               preserveRatio="true"
                               style="-fx-border-color: #bdc3c7; -fx-border-radius: 4;" />
                    <Button text="Seleccionar imagen..."
                            onAction="#seleccionarAvatar" styleClass="btn-secondary" />
                </HBox>

                
                <Label fx:id="lblMensaje" wrapText="true"
                       visible="false" managed="false">
                    <VBox.margin><Insets top="4"/></VBox.margin>
                </Label>

                
                <Button text="Registrarse" onAction="#registrar"
                        maxWidth="Infinity" styleClass="btn-success">
                    <VBox.margin><Insets top="6"/></VBox.margin>
                </Button>

                <Hyperlink text="← Volver al inicio de sesión"
                           onAction="#volverLogin" />

            </VBox>
        </children>
    </VBox>
</ScrollPane>
