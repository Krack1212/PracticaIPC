<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<!--CSS HECHO CON IA-->


<VBox alignment="TOP_CENTER" spacing="0" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="VerPerfil.VerPerfilController">
   <children>
      
      <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 20;">
         <children>
            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Mi Perfil" />
         </children>
      </HBox>

      <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30;">
         <children>
            
            <VBox fillWidth="true" maxWidth="500.0" prefWidth="420.0" spacing="15" style="-fx-padding: 25; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" styleClass="card">
               <children>
                  
                  <HBox alignment="CENTER_LEFT" spacing="20">
                     <children>
                        <VBox alignment="CENTER_LEFT" spacing="4">
                           <children>
                              <Label fx:id="lblDisplayNick" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                              <Label style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;" text="Usuario de Running la Safor" />
                           </children>
                        </VBox>
                        <ImageView fx:id="ivAvatar" fitHeight="70.0" fitWidth="70.0" preserveRatio="true" style="-fx-border-color: #bdc3c7; -fx-border-radius: 50;" />
                     </children>
                  </HBox>
                  
                  <Separator />

                  <VBox spacing="5">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Nickname:" />
                        <Label fx:id="lblNick" style="-fx-font-size: 14px; -fx-padding: 5 0 10 0;" />
                     </children>
                  </VBox>

                  <VBox spacing="5">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Correo electrónico:" />
                        <Label fx:id="lblEmail" style="-fx-font-size: 14px; -fx-padding: 5 0 10 0;" />
                     </children>
                  </VBox>

                  <VBox spacing="5">
                     <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #34495e;" text="Fecha de nacimiento:" />
                        <Label fx:id="lblBirthDate" style="-fx-font-size: 14px; -fx-padding: 5 0 10 0;" />
                     </children>
                  </VBox>
                  
                  <Separator />

                  <HBox alignment="CENTER_RIGHT" spacing="12">
                     <children>
                        <Button mnemonicParsing="false" onAction="#volverAtras" styleClass="btn-secondary" text="Volver" />
                     </children>
                     <VBox.margin>
                        <Insets top="10" />
                     </VBox.margin>
                  </HBox>
                  
               </children>
            </VBox>
            
         </children>
      </VBox>
      
   </children>
</VBox>
